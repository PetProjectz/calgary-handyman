# Inbox that receives Online Estimate submissions via FormSubmit.co.
# Optional — defaults to info@calgary-handyman.com if unset.
# The first submission to a new address triggers a one-time FormSubmit activation email.
NEXT_PUBLIC_ESTIMATE_EMAIL=info@calgary-handyman.com

# Canonical origin for canonicals, JSON-LD, robots.txt and the sitemap.
# Leave unset in production (defaults to https://calgary-handyman.com).
# Set it on preview/staging deploys so they self-canonicalize and emit
# `noindex` + `Disallow: /` instead of competing with the live site.
# NEXT_PUBLIC_SITE_URL=https://preview.example.com
